# ====================================================================
# Stackhouse Environment Variables
# ====================================================================

# --- Core ---
# Database URL (Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stackhouse

# --- Auth ---
# JWT secret for signing access tokens
STACKHOUSE_JWT_SECRET=change-me-in-production

# --- Billing (opt-in) ---
# Set to true to enable the billing module (mounted at /v1/billing)
STACKHOUSE_ENABLE_BILLING=true

# Stripe secret key (server-side, used for creating checkout sessions and cancelling subscriptions)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key

# Stripe webhook signing secret (used to verify incoming Stripe webhooks)
STACKHOUSE_BILLING_STRIPE_SIGNING_SECRET=whsec_replace_with_your_webhook_signing_secret

# Apple shared secret (optional, for App Store receipt validation)
# STACKHOUSE_BILLING_APPLE_SHARED_SECRET=

# Google service account access token (optional, for Play Store receipt validation)
# STACKHOUSE_BILLING_GOOGLE_ACCESS_TOKEN=

# --- UI (build-time, set in .env for Vite) ---
# The billing app ID (must match an app created via /v1/billing/admin/apps)
VITE_BILLING_APP_ID=1

# Stripe price IDs for each plan (create these in your Stripe dashboard)
VITE_STRIPE_PRICE_STARTER=price_replace_with_your_starter_price_id
VITE_STRIPE_PRICE_PRO=price_replace_with_your_pro_price_id
VITE_STRIPE_PRICE_ENTERPRISE=price_replace_with_your_enterprise_price_id
